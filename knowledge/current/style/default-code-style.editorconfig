# EditorConfig
# Generated by fast-harness-init for JavaFramework

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4

[*.gradle.kts]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.json]
indent_size = 2

[*.yaml]
indent_size = 2
